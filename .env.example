# ==============================================================================
# POCKETAI PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace all placeholder values with real ones.
# NEVER commit the .env file to version control!

# ==============================================================================
# CORE DJANGO SETTINGS (REQUIRED)
# ==============================================================================

# Security: Set to 'false' in production, 'true' only for local development
DJANGODEBUG=false

# Security: Generate a new secret key for production!
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-50-character-string-in-production

# Security: Your production domain(s), comma-separated
# Example: ALLOWED_HOSTS=pocketai.com,www.pocketai.com,api.pocketai.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# DATABASE (PostgreSQL with pgvector) - REQUIRED
# ==============================================================================

# Option 1: Use DATABASE_URL (common on Railway, Heroku, Render)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: Individual settings
POSTGRES_DB=pocketai
POSTGRES_USER=pocketai_dev
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==============================================================================
# REDIS CACHING - Highly Recommended
# ==============================================================================

# Redis connection string
# Example: REDIS_URL=redis://redis-host:6379/0
# Leave empty to use local memory cache (development only)
REDIS_URL=

# ==============================================================================
# LLM PROVIDER (Choose one) - REQUIRED
# ==============================================================================

# Primary provider: 'openai' or 'deepseek'
MCP_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# DeepSeek (cheaper alternative)
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ==============================================================================
# EMBEDDING PROVIDER - REQUIRED
# ==============================================================================

# Option 1: Local embeddings (FREE, uses ~500MB RAM per worker)
EMBED_PROVIDER=local
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384

# Option 2: OpenAI embeddings (PAID, $0.02/1M tokens, lighter on resources)
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536
# OPENAI_API_KEY=sk-proj-your-key-here

# ==============================================================================
# HTTPS & SECURITY (Production only - enable AFTER SSL is working!)
# ==============================================================================

# Redirect all HTTP to HTTPS (set 'true' in production ONLY after SSL verified)
SECURE_SSL_REDIRECT=false

# HTTP Strict Transport Security (1 year = 31536000 seconds)
SECURE_HSTS_SECONDS=0

# Require HTTPS for cookies
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# ==============================================================================
# OPTIONAL INTEGRATIONS
# ==============================================================================

# Google Drive/Sheets Integration
#GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-secret-here
# GOOGLE_OAUTH_REDIRECT_URI=https://yourdomain.com/api/integrations/google/callback/

# Email Notifications (for case alerts, password resets)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key

# S3 Storage for File Uploads (recommended for production)
# USE_S3_STORAGE=false
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=pocketai-uploads
# AWS_S3_REGION_NAME=us-east-1

# ==============================================================================
# PERFORMANCE TUNING (Optional)
# ==============================================================================

# Gunicorn workers (recommended: 2-4 × number of CPU cores)
# WEB_CONCURRENCY=4

# Database connection max age (seconds, 0 = no pooling)
# DB_CONN_MAX_AGE=600

# RAG performance tuning (defaults are good for most cases)
# RAG_MAX_SNIPPETS_PER_SEARCH=3
# MCP_MAX_TOOL_ITERATIONS=10
# RAG_MAX_CHUNK_READS_PER_TURN=3

# ==============================================================================
# MONITORING & OBSERVABILITY (Optional)
# ==============================================================================

# Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id
# SENTRY_ENVIRONMENT=production

# OpenTelemetry (traces)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector:4318

# ==============================================================================
# DEVELOPMENT/STAGING FLAGS (Leave default for production)
# ==============================================================================

# Feature flags (all enabled by default, safe in production)
RAG_USE_MCP_ORCHESTRATOR=true
DATASET_MODE_ENABLED=true
RAG_FTS_ENABLED=true

# Disable rate limits (useful for load testing, NOT for production)
MCP_DISABLE_TOOL_RATE_LIMITS=false

# Privacy logging (default: false = no PII in logs)
MCP_LOG_PII=false
MCP_LOG_SNIPPET_PREVIEWS=false
