import React from "react";
import { setStoredBusinessId } from "@/services/http";
import { Link } from "react-router-dom";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Badge } from "@/components/ui/badge";
import { Avatar, AvatarFallback } from "@/components/ui/avatar";
import { Card } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Sheet, SheetContent, SheetHeader, SheetTitle } from "@/components/ui/sheet";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from "@/components/ui/dialog";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuSeparator, DropdownMenuTrigger } from "@/components/ui/dropdown-menu";
import { useToast } from "@/hooks/use-toast";
import {
  Search,
  ChevronDown,
  UserPlus,
  Download,
  Users,
  Mail,
  Phone,
  MapPin,
  Loader2,
  NotebookPen,
  Clock,
} from "lucide-react";
import { useCustomers, useCustomerDetail, useCreateCustomer, useImportCustomers, useCreateCustomerNote, useUpdateCustomerNote } from "@/hooks/useCustomers";
import type { CustomerNote } from "@/services/customers";
import { apiBaseUrl, ApiError } from "@/services/http";
import { getStoredToken, clearToken } from "@/services/auth";
import LoginModal from "@/components/LoginModal";

const lifecycleOptions = [
  { label: "All lifecycle stages", value: undefined },
  { label: "Lead", value: "lead" },
  { label: "Prospect", value: "prospect" },
  { label: "Active", value: "active" },
  { label: "Churn risk", value: "churn_risk" },
  { label: "Former", value: "former" },
];

const dateOptions = [
  { label: "Any time", value: "any" },
  { label: "Last 7 days", value: "7d" },
  { label: "Last 30 days", value: "30d" },
  { label: "Last 90 days", value: "90d" },
];

const limitOptions = [10, 25, 50];

type DateFilterValue = (typeof dateOptions)[number]["value"];

type TabKey = "overview" | "cases" | "activity" | "notes";

const Sidebar = () => {
  const items = [
    { label: "Home", to: "/dashboard" },
    { label: "Cases", to: "/dashboard/cases" },
    { label: "Leads", to: "/dashboard/leads" },
    { label: "Customers", to: "/dashboard/customers", active: true },
    { label: "Agents", to: "/dashboard/agents" },
    { label: "Knowledge", to: "/dashboard/knowledge" },
  ];
  return (
    <aside className="hidden md:flex w-56 shrink-0 border-r border-border/70 bg-card/60 backdrop-blur-sm h-screen sticky top-0 overflow-hidden sidebar-card-chrome">
      <div className="flex flex-col w-full p-3 gap-2">
        <div className="px-2 py-3 text-lg font-semibold">Dashboard <span className="text-xs align-top text-muted-foreground">v0.1</span></div>
        <nav className="mt-1 flex-1 space-y-1">
          {items.map((item) => (
            <Link
              key={item.label}
              to={item.to}
              className={`w-full block text-left px-3 py-2 rounded-md text-sm flex items-center justify-between ${
                item.active ? "bg-primary/10 text-primary" : "hover:bg-muted/60"
              }`}
            >
              <span>{item.label}</span>
            </Link>
          ))}
        </nav>
        <div className="mt-auto rounded-xl p-3 bg-gradient-to-br from-primary/20 via-primary/10 to-primary/5">
          <div className="text-sm font-semibold">Upgrade to PRO</div>
          <div className="text-xs text-muted-foreground mb-2">Get access to all features</div>
          <Button size="sm" className="w-full bg-gradient-primary text-white hover:opacity-90">
            Get Pro Now!
          </Button>
        </div>
        <div className="flex items-center gap-2 px-2 py-3">
          <div className="h-8 w-8 rounded-full bg-muted" />
          <div>
            <div className="text-sm font-medium">Evano</div>
            <div className="text-xs text-muted-foreground">Project Manager</div>
          </div>
        </div>
      </div>
    </aside>
  );
};

const useDebounced = (value: string, delay = 300) => {
  const [debounced, setDebounced] = React.useState(value);
  React.useEffect(() => {
    const id = setTimeout(() => setDebounced(value), delay);
    return () => clearTimeout(id);
  }, [value, delay]);
  return debounced;
};

const formatRelativeTime = (iso: string | null | undefined) => {
  if (!iso) return "—";
  const date = new Date(iso);
  const diff = Date.now() - date.getTime();
  const minutes = Math.round(diff / 60000);
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.round(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.round(hours / 24);
  return `${days}d ago`;
};

const formatDate = (iso: string | null | undefined) => {
  if (!iso) return "—";
  return new Date(iso).toLocaleDateString();
};

const initialsFor = (name: string | null | undefined) => {
  if (!name) return "?";
  const parts = name.split(" ");
  if (parts.length === 1) return parts[0][0]?.toUpperCase() ?? "?";
  return `${parts[0][0] ?? ""}${parts[parts.length - 1][0] ?? ""}`.toUpperCase();
};

type StatCardProps = {
  label: string;
  value?: string;
  helper?: string;
};

const StatCard = React.memo(({ label, value, helper }: StatCardProps) => (
  <Card className="border border-border/70 bg-muted/70 backdrop-blur">
    <div className="p-5 space-y-2">
      <span className="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted-foreground/70">{label}</span>
      {value ? (
        <div className="flex items-baseline justify-between gap-2">
          <span className="text-3xl font-semibold tracking-tight text-foreground">{value}</span>
        </div>
      ) : (
        <div className="text-sm text-muted-foreground">{helper || "No data to measure yet"}</div>
      )}
    </div>
  </Card>
));

const EmptyStateCard = ({ title, description, icon: Icon }: { title: string; description: string; icon: React.ComponentType<{ className?: string }> }) => (
  <Card className="border border-dashed border-border/70 bg-muted/50 p-6 text-center">
    <div className="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-muted">
      <Icon className="h-5 w-5 text-muted-foreground" />
    </div>
    <div className="mt-4 text-sm font-semibold text-foreground">{title}</div>
    <p className="mt-1 text-sm text-muted-foreground">{description}</p>
  </Card>
);

const formatLifecycleLabel = (value: string) => {
  const option = lifecycleOptions.find((item) => item.value === value);
  return option?.label ?? value;
};

const Customers = () => {
  // DEV helper: if X-Business-Id isn't in storage, allow setting from URL (?bid=... or ?businessId=...)
  React.useEffect(() => {
    try {
      const params = new URLSearchParams(window.location.search);
      const incoming = (params.get("bid") || params.get("businessId") || "").trim();
      if (incoming) {
        setStoredBusinessId(incoming);
        if (typeof window !== "undefined") {
          // Clean the URL to avoid re-trigger; don’t hard-refresh
          const url = new URL(window.location.href);
          url.searchParams.delete("bid");
          url.searchParams.delete("businessId");
          window.history.replaceState({}, "", url.toString());
        }
      }
    } catch {
      /* ignore */
    }
  }, []);
  const { toast } = useToast();
  const [loginModalOpen, setLoginModalOpen] = React.useState(false);
  const [loginModalEmail, setLoginModalEmail] = React.useState<string | undefined>(undefined);
  const [search, setSearch] = React.useState("");
  const debouncedSearch = useDebounced(search, 400);
  const [lifecycle, setLifecycle] = React.useState<string | undefined>(undefined);
  const [dateFilter, setDateFilter] = React.useState<DateFilterValue>("any");
  const [limit, setLimit] = React.useState<number>(25);
  const [cursor, setCursor] = React.useState<string | null>(null);
  const [cursorStack, setCursorStack] = React.useState<string[]>([]);
  const [panelOpen, setPanelOpen] = React.useState(false);
  const [activeCustomerId, setActiveCustomerId] = React.useState<string | null>(null);
  const [activeTab, setActiveTab] = React.useState<TabKey>("overview");
  const [importDialogOpen, setImportDialogOpen] = React.useState(false);
  const [importData, setImportData] = React.useState("John Smith, john@example.com\nJane Cooper, jane@example.com");
  const [newCustomer, setNewCustomer] = React.useState({ fullName: "", primaryEmail: "", lifecycleStage: "lead" });
  const [newNoteBody, setNewNoteBody] = React.useState("");
  const [editingNote, setEditingNote] = React.useState<{ id: string; body: string } | null>(null);

  const dateBounds = React.useMemo(() => {
    if (dateFilter === "any") return { from: undefined, to: undefined };
    const to = new Date();
    const from = new Date();
    if (dateFilter === "7d") from.setDate(from.getDate() - 7);
    if (dateFilter === "30d") from.setDate(from.getDate() - 30);
    if (dateFilter === "90d") from.setDate(from.getDate() - 90);
    return { from: from.toISOString().slice(0, 10), to: to.toISOString().slice(0, 10) };
  }, [dateFilter]);

  const listParams = React.useMemo(
    () => ({
      search: debouncedSearch || undefined,
      lifecycleStage: lifecycle,
      dateFrom: dateBounds.from,
      dateTo: dateBounds.to,
      limit,
      cursor: cursor ?? undefined,
    }),
    [cursor, dateBounds.from, dateBounds.to, debouncedSearch, lifecycle, limit]
  );

  const hasBackend = Boolean(apiBaseUrl);
  const [authToken, setAuthToken] = React.useState<string | null>(() => getStoredToken());

  const refreshAuthToken = React.useCallback(() => {
    setAuthToken(getStoredToken());
  }, []);

  React.useEffect(() => {
    refreshAuthToken();
  }, [refreshAuthToken]);

  React.useEffect(() => {
    const handleStorage = (event: StorageEvent) => {
      if (!event.key || event.key === "pocket_ai_access_token") {
        refreshAuthToken();
      }
    };
    const handleFocus = () => refreshAuthToken();
    window.addEventListener("storage", handleStorage);
    window.addEventListener("focus", handleFocus);
    return () => {
      window.removeEventListener("storage", handleStorage);
      window.removeEventListener("focus", handleFocus);
    };
  }, [refreshAuthToken]);

const hasAuthToken = Boolean(authToken);
const canQuery = hasBackend && hasAuthToken;

const customersQuery = useCustomers(canQuery ? listParams : undefined, {
  keepPreviousData: true,
    enabled: canQuery,
  });
  const customers = customersQuery.data?.items ?? [];
  const total = customersQuery.data?.total ?? 0;
  const hasNext = Boolean(customersQuery.data?.hasNext && customersQuery.data?.nextCursor);
  const nextCursor = customersQuery.data?.nextCursor ?? null;
  const hasData = Boolean(customersQuery.data && customersQuery.data.items);
  const authError = customersQuery.error instanceof ApiError && customersQuery.error.status === 401;
  const isInitialLoading = canQuery && customersQuery.isLoading && !hasData;
  const isFetching = canQuery && customersQuery.isFetching && !customersQuery.isLoading;
  const showBackendNotice = !hasBackend;
  const showAuthNotice = hasBackend && !hasAuthToken;
  const showEmptyState = canQuery && customersQuery.isSuccess && customers.length === 0;
  const emptyStateMessage = canQuery
    ? "No customers added yet. Import customers or add one."
    : showAuthNotice
      ? "Sign in to view customer records."
      : "Configure the API base URL to sync data.";
const showErrorState = canQuery && customersQuery.isError && !authError && !hasData;

React.useEffect(() => {
  if (authError) {
    clearToken();
    refreshAuthToken();
  }
}, [authError, refreshAuthToken]);

const detailQuery = useCustomerDetail(
  canQuery && panelOpen ? activeCustomerId : null,
  ["notes", "activity", "cases"],
  {
    enabled: canQuery && panelOpen && Boolean(activeCustomerId),
  }
);
const detailAuthError = detailQuery.error instanceof ApiError && detailQuery.error.status === 401;
const customerDetail = detailQuery.data?.customer ?? null;

React.useEffect(() => {
  if (hasBackend && (showAuthNotice || authError || detailAuthError) && !loginModalOpen) {
    setLoginModalOpen(true);
  }
}, [hasBackend, showAuthNotice, authError, detailAuthError, loginModalOpen]);

const handleLoginSuccess = React.useCallback(
  (result: { token: string; email: string; password: string }) => {
    setLoginModalEmail(result.email);
    refreshAuthToken();
    setLoginModalOpen(false);
    toast({ title: "Signed in", description: `Welcome back, ${result.email}` });
  },
  [refreshAuthToken, toast]
);

React.useEffect(() => {
  setCursor(null);
  setCursorStack([]);
}, [debouncedSearch, lifecycle, dateFilter, limit]);

  const handleNextPage = () => {
    if (!hasNext || !nextCursor) return;
    setCursorStack((prev) => [...prev, cursor ?? ""]);
    setCursor(nextCursor);
  };

  const handlePrevPage = () => {
    setCursorStack((prev) => {
      if (prev.length === 0) {
        setCursor(null);
        return prev;
      }
      const copy = [...prev];
      const previousCursor = copy.pop() ?? null;
      setCursor(previousCursor);
      return copy;
    });
  };

  const openCustomerPanel = (id: string) => {
    setActiveCustomerId(id);
    setPanelOpen(true);
    setActiveTab("overview");
  };

React.useEffect(() => {
  if (!panelOpen) {
    setNewNoteBody("");
    setEditingNote(null);
  }
}, [panelOpen]);

  const createCustomerMutation = useCreateCustomer({
    onSuccess: (result) => {
      toast({ title: "Customer created", description: result.customer.fullName });
      setNewCustomer({ fullName: "", primaryEmail: "", lifecycleStage: "lead" });
    },
    onError: (err) => {
      toast({ title: "Unable to create customer", description: err instanceof Error ? err.message : "Unknown error", variant: "destructive" });
    },
  });

  const importCustomersMutation = useImportCustomers({
    onSuccess: (result) => {
      toast({ title: "Import queued", description: `${result.importedCount} rows accepted` });
      setImportDialogOpen(false);
    },
    onError: (err) => {
      toast({ title: "Import failed", description: err instanceof Error ? err.message : "Unknown error", variant: "destructive" });
    },
  });

  const createNoteMutation = useCreateCustomerNote(activeCustomerId ?? "", {
    onSuccess: (note) => {
      toast({ title: "Note added", description: note.body.slice(0, 80) });
      setNewNoteBody("");
    },
    onError: (err) => {
      toast({ title: "Unable to add note", description: err instanceof Error ? err.message : "Unknown error", variant: "destructive" });
    },
  });

  const updateNoteMutation = useUpdateCustomerNote(activeCustomerId ?? "", {
    onSuccess: (note) => {
      toast({ title: "Note updated", description: note.body.slice(0, 80) });
      setEditingNote(null);
    },
    onError: (err) => {
      toast({ title: "Unable to update note", description: err instanceof Error ? err.message : "Unknown error", variant: "destructive" });
    },
  });

  const handleCreateCustomer = async () => {
    if (!hasBackend) {
      toast({ title: "Backend not connected", description: "Configure the API base URL to sync customers.", variant: "destructive" });
      return;
    }
    if (!hasAuthToken) {
      toast({ title: "Sign in required", description: "Please sign in again to create customers.", variant: "destructive" });
      if (newCustomer.primaryEmail.trim()) setLoginModalEmail(newCustomer.primaryEmail.trim());
      setLoginModalOpen(true);
      return;
    }
    if (!newCustomer.fullName.trim()) {
      toast({ title: "Full name is required", variant: "destructive" });
      return;
    }
    await createCustomerMutation.mutateAsync({
      fullName: newCustomer.fullName.trim(),
      primaryEmail: newCustomer.primaryEmail.trim() || null,
      lifecycleStage: newCustomer.lifecycleStage,
      contactMethods: [],
      personaTags: [],
      tagIds: [],
    });
  };

  const handleImport = async () => {
    if (!hasBackend) {
      toast({ title: "Backend not connected", description: "Configure the API base URL before importing customers.", variant: "destructive" });
      return;
    }
    if (!hasAuthToken) {
      toast({ title: "Sign in required", description: "Please sign in again before importing customers.", variant: "destructive" });
      const potentialEmail = rows.find((row) => row.email)?.email;
      if (potentialEmail) setLoginModalEmail(potentialEmail);
      setLoginModalOpen(true);
      return;
    }
    const rows = importData
      .split("\n")
      .map((line) => line.trim())
      .filter(Boolean)
      .map((line) => {
        const [name, email] = line.split(",");
        return {
          fullName: (name ?? "").trim(),
          email: email ? email.trim() : undefined,
        };
      })
      .filter((row) => row.fullName.length > 0);
    if (rows.length === 0) {
      toast({ title: "Nothing to import", description: "Provide at least one line with a customer name.", variant: "destructive" });
      return;
    }
    await importCustomersMutation.mutateAsync({
      skipDuplicates: true,
      rows: rows.map((row) => ({
        fullName: row.fullName,
        email: row.email,
        phone: undefined,
        country: undefined,
        lifecycleStage: undefined,
        tags: [],
      })),
    });
  };

  const handleCreateNote = async () => {
    if (!hasBackend) {
      toast({ title: "Backend not connected", description: "Configure the API base URL before adding notes.", variant: "destructive" });
      return;
    }
    if (!hasAuthToken) {
      toast({ title: "Sign in required", description: "Please sign in again before adding notes.", variant: "destructive" });
      setLoginModalOpen(true);
      return;
    }
    if (!activeCustomerId || !newNoteBody.trim()) return;
    await createNoteMutation.mutateAsync({
      body: newNoteBody.trim(),
      visibility: "internal",
      pinned: false,
    });
  };

  const handleUpdateNote = async () => {
    if (!hasBackend) {
      toast({ title: "Backend not connected", description: "Configure the API base URL before updating notes.", variant: "destructive" });
      return;
    }
    if (!hasAuthToken) {
      toast({ title: "Sign in required", description: "Please sign in again before updating notes.", variant: "destructive" });
      setLoginModalOpen(true);
      return;
    }
    if (!activeCustomerId || !editingNote || !editingNote.body.trim()) return;
    await updateNoteMutation.mutateAsync({
      noteId: editingNote.id,
      payload: {
        body: editingNote.body.trim(),
      },
    });
  };

  const lifecycleLabel = lifecycleOptions.find((item) => item.value === lifecycle)?.label ?? lifecycleOptions[0].label;
  const dateLabel = dateOptions.find((item) => item.value === dateFilter)?.label ?? dateOptions[0].label;

  return (
    <div className="min-h-screen bg-background flex">
      <Sidebar />
      <main className="flex-1 overflow-auto">
        <div className="w-full px-4 md:px-6 lg:px-8 py-6 space-y-6">
          <header className="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
            <div>
              <h1 className="text-xl md:text-2xl font-semibold text-gradient-hero">Customers</h1>
              <p className="text-sm text-muted-foreground">Manage your customer relationships, activity, and notes in one hub.</p>
            </div>
            <div className="flex items-center gap-2 flex-wrap">
              <Dialog>
                <DialogTrigger asChild>
                  <Button className="gap-2">
                    <UserPlus className="h-4 w-4" />
                    New Customer
                  </Button>
                </DialogTrigger>
                <DialogContent className="sm:max-w-md">
                  <DialogHeader>
                    <DialogTitle>Create customer</DialogTitle>
                  </DialogHeader>
                  <div className="space-y-3">
                    <Input
                      placeholder="Full name"
                      value={newCustomer.fullName}
                      onChange={(event) => setNewCustomer((prev) => ({ ...prev, fullName: event.target.value }))}
                    />
                    <Input
                      placeholder="Email"
                      type="email"
                      value={newCustomer.primaryEmail}
                      onChange={(event) => setNewCustomer((prev) => ({ ...prev, primaryEmail: event.target.value }))}
                    />
                    <DropdownMenu>
                      <DropdownMenuTrigger asChild>
                        <Button variant="outline" className="justify-between">
                          <span>{formatLifecycleLabel(newCustomer.lifecycleStage)}</span>
                          <ChevronDown className="h-4 w-4" />
                        </Button>
                      </DropdownMenuTrigger>
                      <DropdownMenuContent align="start" className="w-44">
                        {lifecycleOptions.slice(1).map((option) => (
                          <DropdownMenuItem
                            key={option.value}
                            onClick={() => setNewCustomer((prev) => ({ ...prev, lifecycleStage: option.value ?? "lead" }))}
                          >
                            {option.label}
                          </DropdownMenuItem>
                        ))}
                      </DropdownMenuContent>
                    </DropdownMenu>
                    <Button onClick={handleCreateCustomer} disabled={createCustomerMutation.isPending} className="w-full">
                      {createCustomerMutation.isPending && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}Create
                    </Button>
                  </div>
                </DialogContent>
              </Dialog>
              <Dialog open={importDialogOpen} onOpenChange={setImportDialogOpen}>
                <DialogTrigger asChild>
                  <Button variant="outline" className="gap-2 text-sm">
                    <Download className="h-4 w-4" />
                    Import customers
                  </Button>
                </DialogTrigger>
                <DialogContent className="sm:max-w-lg">
                  <DialogHeader>
                    <DialogTitle>Import customers</DialogTitle>
                  </DialogHeader>
                  <div className="space-y-4">
                    <p className="text-sm text-muted-foreground">
                      Paste one customer per line. Format: <code>Name, email(optional)</code>.
                    </p>
                    <textarea
                      value={importData}
                      onChange={(event) => setImportData(event.target.value)}
                      className="w-full min-h-[160px] rounded-md border border-border bg-transparent p-3 text-sm"
                    />
                    <Button onClick={handleImport} disabled={importCustomersMutation.isPending}>
                      {importCustomersMutation.isPending && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}Upload
                    </Button>
                  </div>
                </DialogContent>
              </Dialog>
            </div>
          </header>

          <section className="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <StatCard label="New customers" helper="No data to measure yet" />
            <StatCard label="Satisfied customers" helper="No data to measure yet" />
            <StatCard label="Expansion opportunities" helper="No data to measure yet" />
          </section>

          <section className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div className="flex flex-col gap-2 md:flex-row md:items-center md:flex-wrap">
              <div className="relative w-full md:w-64">
                <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                <Input
                  className="pl-9"
                  placeholder="Search name, email, text…"
                  value={search}
                  onChange={(event) => setSearch(event.target.value)}
                />
              </div>
              <DropdownMenu>
                <DropdownMenuTrigger asChild>
                  <Button variant="outline" className="gap-2 text-sm">
                    <Users className="h-4 w-4" />
                    {lifecycleLabel}
                    <ChevronDown className="h-4 w-4 text-muted-foreground" />
                  </Button>
                </DropdownMenuTrigger>
                <DropdownMenuContent align="start" className="w-44">
                  {lifecycleOptions.map((option) => (
                    <DropdownMenuItem key={option.label} onClick={() => setLifecycle(option.value)}>
                      {option.label}
                    </DropdownMenuItem>
                  ))}
                </DropdownMenuContent>
              </DropdownMenu>
              <DropdownMenu>
                <DropdownMenuTrigger asChild>
                  <Button variant="outline" className="gap-2 text-sm">
                    <Clock className="h-4 w-4" />
                    {dateLabel}
                    <ChevronDown className="h-4 w-4 text-muted-foreground" />
                  </Button>
                </DropdownMenuTrigger>
                <DropdownMenuContent align="start" className="w-40">
                  {dateOptions.map((option) => (
                    <DropdownMenuItem key={option.value} onClick={() => setDateFilter(option.value)}>
                      {option.label}
                    </DropdownMenuItem>
                  ))}
                </DropdownMenuContent>
              </DropdownMenu>
            </div>
            <DropdownMenu>
              <DropdownMenuTrigger asChild>
                <Button variant="outline" className="gap-2 text-sm">
                  {`Page size: ${limit}`}
                  <ChevronDown className="h-4 w-4 text-muted-foreground" />
                </Button>
              </DropdownMenuTrigger>
              <DropdownMenuContent align="end" className="w-32">
                {limitOptions.map((value) => (
                  <DropdownMenuItem key={value} onClick={() => setLimit(value)}>
                    {value}
                  </DropdownMenuItem>
                ))}
              </DropdownMenuContent>
            </DropdownMenu>
          </section>

          <section className="space-y-4">
            <Card className="border border-border/70 bg-card/80 shadow-sm">
              <div className="relative overflow-x-auto">
                <Table className="min-w-full">
                  <TableHeader className="sticky top-0 bg-muted/70 backdrop-blur">
                    <TableRow>
                      <TableHead className="w-[240px]">Customer</TableHead>
                      <TableHead>Email</TableHead>
                      <TableHead className="text-right">Conversations</TableHead>
                      <TableHead className="text-right">Satisfaction</TableHead>
                      <TableHead className="text-right">Last contact</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {showBackendNotice ? (
                      <TableRow hoverable={false}>
                        <TableCell colSpan={5} className="py-12 text-center text-sm text-muted-foreground">
                          Configure the API base URL to sync customer data.
                        </TableCell>
                      </TableRow>
                    ) : showAuthNotice ? (
                      <TableRow hoverable={false}>
                        <TableCell colSpan={5} className="py-12 text-center text-sm text-muted-foreground">
                          You have been signed out. Please sign in to view customers.
                        </TableCell>
                      </TableRow>
                    ) : isInitialLoading ? (
                      <TableRow hoverable={false}>
                        <TableCell colSpan={5} className="py-12 text-center text-sm text-muted-foreground">
                          <div className="flex items-center justify-center gap-2">
                            <Loader2 className="h-4 w-4 animate-spin" />
                            Loading customers…
                          </div>
                        </TableCell>
                      </TableRow>
                    ) : authError ? (
                      <TableRow hoverable={false}>
                        <TableCell colSpan={5} className="py-12 text-center text-sm text-muted-foreground">
                          Session expired. Refresh and sign in again to continue.
                        </TableCell>
                      </TableRow>
                    ) : showErrorState ? (
                      <TableRow hoverable={false}>
                        <TableCell colSpan={5} className="py-12 text-center text-sm text-muted-foreground">
                          Unable to load customers. Please check your connection and try again.
                        </TableCell>
                      </TableRow>
                    ) : showEmptyState ? (
                      <TableRow hoverable={false}>
                        <TableCell colSpan={5} className="py-12 text-center text-sm text-muted-foreground">
                          {emptyStateMessage}
                        </TableCell>
                      </TableRow>
                    ) : (
                      customers.map((customer) => (
                        <TableRow key={customer.id} className="cursor-pointer hover:bg-muted/60" onClick={() => openCustomerPanel(customer.id)}>
                          <TableCell>
                            <div className="flex items-center gap-3">
                              <Avatar className="h-9 w-9 border border-border/70">
                                <AvatarFallback>{initialsFor(customer.fullName)}</AvatarFallback>
                              </Avatar>
                              <div>
                                <div className="text-sm font-semibold text-foreground">{customer.fullName}</div>
                                <div className="text-xs text-muted-foreground">{formatLifecycleLabel(customer.lifecycleStage)}</div>
                              </div>
                            </div>
                          </TableCell>
                          <TableCell>
                            <div className="text-sm text-muted-foreground">{customer.primaryEmail ?? "—"}</div>
                          </TableCell>
                          <TableCell className="text-right text-sm font-medium">{customer.conversationsCount}</TableCell>
                          <TableCell className="text-right text-sm font-medium">
                            {customer.satisfactionScore !== null ? `${Math.round(customer.satisfactionScore)}%` : "—"}
                          </TableCell>
                          <TableCell className="text-right text-sm text-muted-foreground">{formatRelativeTime(customer.lastContactAt)}</TableCell>
                        </TableRow>
                      ))
                    )}
                  </TableBody>
                </Table>
              </div>
              <div className="flex items-center justify-between border-t border-border/70 px-4 py-3 text-xs text-muted-foreground">
                <div>Showing {customers.length} of {total} customers</div>
                <div className="flex items-center gap-2">
                  <Button variant="ghost" size="sm" onClick={handlePrevPage} disabled={cursorStack.length === 0 || isFetching}>
                    Previous
                  </Button>
                  <Button variant="ghost" size="sm" onClick={handleNextPage} disabled={!hasNext || isFetching}>
                    Next
                  </Button>
                  {isFetching && <Loader2 className="h-3.5 w-3.5 animate-spin text-muted-foreground" />}
                </div>
              </div>
            </Card>
          </section>

        </div>
      </main>

      <Sheet open={panelOpen} onOpenChange={setPanelOpen}>
        <SheetContent className="w-full sm:max-w-xl lg:max-w-2xl overflow-y-auto">
          <SheetHeader>
            <SheetTitle>Customer overview</SheetTitle>
          </SheetHeader>
          {!canQuery ? (
            <div className="py-8 text-sm text-muted-foreground">
              {hasBackend
                ? "You have been signed out. Please sign in to view customer details."
                : "Configure the API base URL to load customer details."}
            </div>
          ) : detailAuthError ? (
            <div className="py-8 text-sm text-muted-foreground">Session expired. Refresh and sign in again to inspect this customer.</div>
          ) : detailQuery.isLoading ? (
            <div className="flex items-center gap-2 py-8 text-sm text-muted-foreground">
              <Loader2 className="h-4 w-4 animate-spin" />
              Loading customer data…
            </div>
          ) : !customerDetail ? (
            <div className="py-8 text-sm text-muted-foreground">Select a customer to view details.</div>
          ) : (
            <div className="py-6 space-y-6">
              <div className="flex flex-col gap-3">
                <div className="flex items-center gap-3">
                  <Avatar className="h-12 w-12 border border-border/70">
                    <AvatarFallback>{initialsFor(customerDetail.fullName)}</AvatarFallback>
                  </Avatar>
                  <div>
                    <div className="text-lg font-semibold">{customerDetail.fullName}</div>
                    <div className="text-xs text-muted-foreground">Created {formatDate(customerDetail.createdAt)}</div>
                  </div>
                </div>
                <div className="flex flex-wrap gap-2">
                  <Badge variant="secondary">Lifecycle: {formatLifecycleLabel(customerDetail.lifecycleStage)}</Badge>
                  {customerDetail.personaTags.map((tag) => (
                    <Badge key={tag} variant="outline">
                      {tag}
                    </Badge>
                  ))}
                </div>
              </div>

              <Tabs value={activeTab} onValueChange={(value) => setActiveTab(value as TabKey)} className="w-full">
                <TabsList className="grid grid-cols-4 w-full">
                  <TabsTrigger value="overview">Overview</TabsTrigger>
                  <TabsTrigger value="cases">Cases</TabsTrigger>
                  <TabsTrigger value="activity">Activity</TabsTrigger>
                  <TabsTrigger value="notes">Notes</TabsTrigger>
                </TabsList>

                <TabsContent value="overview" className="space-y-4 pt-4">
                  <Card className="p-4 space-y-3">
                    <div className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Contact</div>
                    <div className="space-y-2 text-sm">
                      <div className="flex items-center gap-2 text-muted-foreground">
                        <Mail className="h-4 w-4" />
                        <span>{customerDetail.primaryEmail ?? "—"}</span>
                      </div>
                      <div className="flex items-center gap-2 text-muted-foreground">
                        <Phone className="h-4 w-4" />
                        <span>{customerDetail.primaryPhone ?? "—"}</span>
                      </div>
                      <div className="flex items-center gap-2 text-muted-foreground">
                        <MapPin className="h-4 w-4" />
                        <span>{customerDetail.country ?? "—"}</span>
                      </div>
                    </div>
                  </Card>
                  <Card className="p-4 space-y-3">
                    <div className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Stats</div>
                    <div className="grid grid-cols-2 gap-3 text-sm">
                      <div>
                        <div className="text-xs text-muted-foreground uppercase tracking-wide">Total conversations</div>
                        <div className="text-base font-semibold">{customerDetail.stats.conversationsTotal}</div>
                      </div>
                      <div>
                        <div className="text-xs text-muted-foreground uppercase tracking-wide">Last 30 days</div>
                        <div className="text-base font-semibold">{customerDetail.stats.conversationsLast30Days}</div>
                      </div>
                      <div>
                        <div className="text-xs text-muted-foreground uppercase tracking-wide">CSAT</div>
                        <div className="text-base font-semibold">
                          {customerDetail.stats.csatAverage !== null ? `${Math.round(customerDetail.stats.csatAverage)}%` : "—"}
                        </div>
                      </div>
                      <div>
                        <div className="text-xs text-muted-foreground uppercase tracking-wide">Expansion opportunities</div>
                        <div className="text-base font-semibold">{customerDetail.stats.expansionOpportunities}</div>
                      </div>
                    </div>
                  </Card>
                </TabsContent>

                <TabsContent value="cases" className="space-y-4 pt-4">
                  <Card className="p-4 space-y-3">
                    <div className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Open cases</div>
                    {customerDetail.casesOpen.length === 0 ? (
                      <div className="text-sm text-muted-foreground">No active cases.</div>
                    ) : (
                      <ul className="space-y-3 text-sm">
                        {customerDetail.casesOpen.map((item) => (
                          <li key={item.id} className="rounded-md border border-border/70 p-3">
                            <div className="flex items-center justify-between">
                              <span className="font-semibold">{item.title}</span>
                              <Badge variant="secondary">{item.priority}</Badge>
                            </div>
                            <div className="mt-1 text-xs text-muted-foreground">Opened {formatDate(item.openedAt)}</div>
                            <div className="mt-1 text-xs uppercase tracking-wide text-muted-foreground">Status: {item.status}</div>
                          </li>
                        ))}
                      </ul>
                    )}
                  </Card>
                  <Card className="p-4 space-y-3">
                    <div className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Resolved cases</div>
                    {customerDetail.casesResolved.length === 0 ? (
                      <div className="text-sm text-muted-foreground">No resolved cases yet.</div>
                    ) : (
                      <ul className="space-y-3 text-sm">
                        {customerDetail.casesResolved.map((item) => (
                          <li key={item.id} className="rounded-md border border-border/70 p-3">
                            <div className="flex items-center justify-between">
                              <span className="font-semibold">{item.title}</span>
                              <Badge variant="outline">{item.priority}</Badge>
                            </div>
                            <div className="mt-1 text-xs text-muted-foreground">Closed {formatDate(item.openedAt)}</div>
                          </li>
                        ))}
                      </ul>
                    )}
                  </Card>
                </TabsContent>

                <TabsContent value="activity" className="space-y-3 pt-4">
                  {customerDetail.activity.length === 0 ? (
                    <Card className="p-4 text-sm text-muted-foreground">No activity recorded yet.</Card>
                  ) : (
                    <div className="space-y-3">
                      {customerDetail.activity.map((event) => (
                        <Card key={event.id} className="p-4">
                          <div className="text-sm font-semibold text-foreground">{event.eventType}</div>
                          <div className="text-xs text-muted-foreground mt-1">{formatDate(event.occurredAt)}</div>
                          {event.details ? (
                            <pre className="mt-2 rounded-md bg-muted p-2 text-xs text-muted-foreground">{JSON.stringify(event.details, null, 2)}</pre>
                          ) : null}
                        </Card>
                      ))}
                    </div>
                  )}
                </TabsContent>

                <TabsContent value="notes" className="space-y-4 pt-4">
                  <Card className="p-4 space-y-3">
                    <div className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">New note</div>
                    <textarea
                      value={newNoteBody}
                      onChange={(event) => setNewNoteBody(event.target.value)}
                      placeholder="Add an internal note"
                      className="w-full min-h-[120px] rounded-md border border-border bg-transparent p-3 text-sm"
                    />
                    <Button onClick={handleCreateNote} disabled={!newNoteBody.trim() || createNoteMutation.isPending || !activeCustomerId}>
                      {createNoteMutation.isPending && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}Save note
                    </Button>
                  </Card>
                  {customerDetail.notes.length === 0 ? (
                    <Card className="p-4 text-sm text-muted-foreground">No notes recorded yet.</Card>
                  ) : (
                    <div className="space-y-3">
                      {customerDetail.notes.map((note: CustomerNote) => (
                        <Card key={note.id} className="p-4 space-y-2">
                          <div className="flex items-center justify-between text-xs text-muted-foreground">
                            <span>{formatDate(note.createdAt)}</span>
                            <Badge variant={note.pinned ? "default" : "outline"}>{note.visibility}</Badge>
                          </div>
                          {editingNote?.id === note.id ? (
                            <>
                              <textarea
                                value={editingNote.body}
                                onChange={(event) => setEditingNote({ id: note.id, body: event.target.value })}
                                className="w-full rounded-md border border-border bg-transparent p-3 text-sm"
                              />
                              <div className="flex items-center gap-2">
                                <Button size="sm" onClick={handleUpdateNote} disabled={updateNoteMutation.isPending}>
                                  {updateNoteMutation.isPending && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}Update
                                </Button>
                                <Button size="sm" variant="ghost" onClick={() => setEditingNote(null)}>
                                  Cancel
                                </Button>
                              </div>
                            </>
                          ) : (
                            <>
                              <p className="text-sm text-foreground whitespace-pre-wrap">{note.body}</p>
                              <Button size="sm" variant="ghost" onClick={() => setEditingNote({ id: note.id, body: note.body })}>
                                <NotebookPen className="mr-2 h-4 w-4" />Edit
                              </Button>
                            </>
                          )}
                        </Card>
                      ))}
                    </div>
                  )}
                </TabsContent>
              </Tabs>
            </div>
          )}
        </SheetContent>
      </Sheet>
      <LoginModal
        open={loginModalOpen}
        onOpenChange={setLoginModalOpen}
        initialEmail={loginModalEmail}
        onSuccess={handleLoginSuccess}
      />
    </div>
  );
};

export default Customers;
